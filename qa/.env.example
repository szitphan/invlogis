# Sao chép thành qa/.env (đã gitignore). KHÔNG commit giá trị thật.
# Môi trường chạy: dev | sit | local (KHÔNG có prod)
QA_ENV=dev
# Tenant id gửi ở header X-Tenant-Id
QA_TENANT_ID=
# Ghi đè webBase trong config/envs.json (host web FE của môi trường)
QA_WEB_BASE=
# Mã module cấp working context cho web (mặc định fuel)
QA_MODULE_CODE=

# Mỗi vai: user/pass + (tuỳ chọn) đơn vị tổ chức làm việc, cơ sở (facility) id
QA_REQUESTER_MOBILE_USER=
QA_REQUESTER_MOBILE_PASS=
QA_REQUESTER_MOBILE_ORG_UNIT=
QA_REQUESTER_MOBILE_FACILITY=

QA_APPROVER_USER=
QA_APPROVER_PASS=
QA_APPROVER_ORG_UNIT=
QA_APPROVER_FACILITY=

QA_WEB_VIEWER_USER=
QA_WEB_VIEWER_PASS=
QA_WEB_VIEWER_ORG_UNIT=
QA_WEB_VIEWER_FACILITY=

QA_PARTNER_STATION_USER=
QA_PARTNER_STATION_PASS=
QA_PARTNER_STATION_ORG_UNIT=
QA_PARTNER_STATION_FACILITY=

QA_FINANCE_USER=
QA_FINANCE_PASS=
QA_FINANCE_ORG_UNIT=
QA_FINANCE_FACILITY=

# IgasSimulator (giả lập bơm) — environments/*.yml do bruno-runner sinh đọc {{process.env.IGAS_SIM_BASE}} / {{process.env.IGAS_SIM_KEY}}
IGAS_SIM_BASE=
IGAS_SIM_KEY=

# Maestro (app Flutter): applicationId / bundle id của app trên simulator
APP_ID=

# Đọc DB (chỉ SELECT, xem db/queries/README.md) — tuỳ chọn
QA_DB_CONNECTION=
