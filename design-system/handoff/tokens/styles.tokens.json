  "shadow": {
    "xs": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#0000000D",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ],
      "$description": "Thẻ (vai thẻ, DEC-327)"
    },
    "sm": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#0000001A",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0px"
        },
        {
          "color": "#0000001A",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "-1px"
        }
      ],
      "$description": "Thang Untitled, chưa gán vai"
    },
    "md": {
      "$type": "shadow",
      "$value": [
        {
