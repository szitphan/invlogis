  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "125ms"
      },
      "medium": {
        "$type": "duration",
        "$value": "300ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "500ms"
      },
      "exit": {
        "$type": "duration",
        "$value": "200ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.24,
          1.0,
          0.4,
          1.0
        ]
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0.0,
          1.0,
          1.0
        ]
      }
    },
    "preset": {
      "fade-in": {
        "$type": "transition",
        "$value": {
          "duration": "125ms",
          "delay": "0ms",
          "timingFunction": [
            0.24,
            1.0,
            0.4,
            1.0
          ]
        },
        "$description": "Số đổi, nội dung sau skeleton (an07, an11)"
      },
      "pop": {
        "$type": "transition",
        "$value": {
          "duration": "300ms",
          "delay": "0ms",
          "timingFunction": [
            0.24,
            1.0,
            0.4,
            1.0
          ]
        },
        "$description": "Đĩa dấu kết quả (an02)"
      },
      "draw": {
        "$type": "transition",
        "$value": {
          "duration": "300ms",
          "delay": "0ms",
          "timingFunction": [
            0.24,
            1.0,
            0.4,
            1.0
          ]
        },
        "$description": "Vẽ nét dấu kết quả; đường path có pathLength=1, dấu tích đi từ nét ngắn sang nét dài (an02)"
      },
      "swap": {
        "$type": "transition",
        "$value": {
          "duration": "125ms",
          "delay": "0ms",
          "timingFunction": [
            0.24,
            1.0,
            0.4,
            1.0
          ]
        },
        "$description": "Đổi icon tại chỗ, giữ 1000 rồi về (an05)"
      },
      "flash": {
        "$type": "transition",
        "$value": {
          "duration": "1500ms",
          "delay": "0ms",
          "timingFunction": [
            0.0,
            0.0,
            1.0,
            1.0
          ]
        },
        "$description": "Dòng vừa đổi, chạy một lần: giữ 1000, phai 500 (an06, an08)"
      },
      "expand": {
        "$type": "transition",
        "$value": {
          "duration": "300ms",
          "delay": "0ms",
          "timingFunction": [
            0.24,
            1.0,
            0.4,
            1.0
          ]
        },
        "$description": "Mở, đóng khối, dòng mới, dải mất mạng (an08, an10, an16). Bật bằng data-open=\"true\""
      },
      "glide": {
        "$type": "transition",
        "$value": {
          "duration": "300ms",
          "delay": "0ms",
          "timingFunction": [
            0.24,
            1.0,
            0.4,
            1.0
          ]
        },
        "$description": "Xe trên bản đồ khi có điểm GPS mới (an12)"
      },
      "grow": {
        "$type": "transition",
        "$value": {
          "duration": "300ms",
          "delay": "0ms",
          "timingFunction": [
            0.24,
            1.0,
            0.4,
            1.0
          ]
        },
        "$description": "Cột biểu đồ mọc khi tải, đổi lọc thì đổi ngay (an17)"
      }
    }
  },
  "backdrop-blur": {
    "sm": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Đầu màn, thanh công cụ dính trên cùng khi cuộn (nền color/bg/primary_blur)."
    },
    "md": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Thanh điều hướng nổi app (DEC-160), thanh hành động nổi đáy màn (nền color/bg/primary_blur)."
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Nền sau dialog, sheet: color/bg/overlay 35% + blur; máy yếu lùi color/bg/overlay_solid."
    },
    "xl": {
      "$type": "dimension",
      "$value": "40px",
      "$description": "Giữ cho đủ thang, chưa dùng trong app nghiệp vụ."
    }
  }
}
