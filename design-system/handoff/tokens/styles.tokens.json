  "elev": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#1018280F",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ],
      "$description": "Thẻ (DEC-125)"
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#1018281A",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "0px"
        },
        {
          "color": "#1018280F",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0px"
        }
      ],
      "$description": "Menu thả, popover, gợi ý ô tìm"
    },
    "3": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#10182829",
          "offsetX": "0px",
          "offsetY": "16px",
          "blur": "40px",
          "spread": "0px"
        },
        {
          "color": "#1018281A",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "0px"
        }
      ],
      "$description": "Dialog, sheet, toast"
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "125ms"
      },
      "medium": {
        "$type": "duration",
        "$value": "300ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "700ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.24,
          1.0,
          0.4,
          1.0
        ]
      }
    }
  },
  "blur": {
    "sm": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Đầu màn, thanh công cụ dính trên cùng khi cuộn (nền trắng 70%)."
    },
    "md": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Thanh điều hướng nổi app (DEC-160), thanh hành động nổi đáy màn."
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Nền sau dialog, sheet: scrim 35% + blur."
    },
    "xl": {
      "$type": "dimension",
      "$value": "40px",
      "$description": "Không dùng trong app nghiệp vụ."
    }
  }
