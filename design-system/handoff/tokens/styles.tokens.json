    },
    "2xl": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#0000002E",
          "offsetX": "0px",
          "offsetY": "24px",
          "blur": "48px",
          "spread": "-12px"
        },
        {
          "color": "#0000000A",
          "offsetX": "0px",
          "offsetY": "4px",
